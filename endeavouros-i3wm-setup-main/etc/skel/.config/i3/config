# change focus (SUPER+flechas estilo KooL)
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window (SUPER+CTRL+flechas)
bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Down move down
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Right move right

# resize focused window (SUPER+SHIFT+flechas, binde = repetir al mantener)
binde $mod+Shift+Left resize shrink width 20 px or 20 ppt
binde $mod+Shift+Right resize grow width 20 px or 20 ppt
binde $mod+Shift+Up resize shrink height 20 px or 20 ppt
binde $mod+Shift+Down resize grow height 20 px or 20 ppt

# split in horizontal orientation (SUPER+CTRL+H)
bindsym $mod+Ctrl+h split h

# split in vertical orientation (SUPER+CTRL+V)
bindsym $mod+Ctrl+v split v

# enter fullscreen mode for the focused container (SUPER+SHIFT+F)
bindsym $mod+Shift+f fullscreen toggle

# fake fullscreen: ventana flotante a tamaño completo (SUPER+CTRL+F)
bindsym $mod+Ctrl+f exec --no-startup-id i3-msg '[con_id=__focused__] floating enable, resize set 100 ppt 100 ppt'

# toggle layout: default/split/stacking/tabbed (SUPER+ALT+L)
bindsym $mod+Alt+l layout toggle

# change container layout (SUPER+CTRL+S / SUPER+CTRL+G)
bindsym $mod+Ctrl+s layout stacking
bindsym $mod+Ctrl+g layout tabbed

# toggle tiling / floating (SUPER+Space)
bindsym $mod+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+Shift+space focus mode_toggle

# toggle blur de picom on/off (SUPER+ALT+O)
bindsym $mod+Alt+o exec --no-startup-id ~/.config/i3/scripts/toggle-blur.sh

# toggle opacidad de la ventana activa (SUPER+CTRL+O)
bindsym $mod+Ctrl+o exec --no-startup-id ~/.config/i3/scripts/toggle-opacity.sh

# focus the parent container
bindsym $mod+a focus parent

# ocultar/mostrar barra (CTRL+ALT+B)
bindsym Control+Mod1+b exec --no-startup-id i3-msg '[bar="bar-0"] mode toggle'

# panel de notificaciones dunst (SUPER+SHIFT+N)
bindsym $mod+Shift+n exec --no-startup-id dunstctl history-pop

# open new empty workspace (SUPER+CTRL+N)
bindsym $mod+Ctrl+n exec --no-startup-id ~/.config/i3/scripts/empty_workspace

