######################################
# keybindings for different actions: #
######################################
# Estilo KooL Hyprland (adaptado a i3/X11)

# start a terminal (kitty)
bindsym $mod+Return exec --no-startup-id kitty

# dropdown terminal (flotante, centrada)
bindsym $mod+Shift+Return exec --no-startup-id kitty --class=kitty-dropdown
for_window [class="kitty-dropdown"] floating enable, move position center, resize set 70 ppt 60 ppt

# kill focused window
bindsym $mod+q kill

# kill el proceso de la ventana activa (kill -9)
bindsym $mod+Shift+q exec --no-startup-id ~/.config/i3/scripts/kill-active-process.sh

# power menu (rofi)
bindsym Control+Mod1+p exec --no-startup-id ~/.config/i3/scripts/powermenu

# Lock the system (CTRL+ALT+L estilo KooL, alias SUPER+L)
bindsym Control+Mod1+l exec --no-startup-id ~/.config/i3/scripts/blur-lock
bindsym $mod+l exec --no-startup-id ~/.config/i3/scripts/blur-lock
# lock in case after sleep
exec --no-startup-id xss-lock -l ~/.config/i3/scripts/blur-lock

# salir de i3 (CTRL+ALT+Del, ojo: sale de inmediato)
bindsym Control+Mod1+Delete exec --no-startup-id i3-msg exit

# reload the configuration file
bindsym $mod+Shift+c reload

# restart i3 inplace (preserves your layout/session, can be used to update i3)
bindsym $mod+Shift+r restart

# refresh i3 + dunst + greenclip (SUPER+ALT+R)
bindsym $mod+Alt+r exec --no-startup-id ~/.config/i3/scripts/refresh.sh

# cheat sheet de keybinds (SUPER+H / F1)
bindsym $mod+h exec --no-startup-id ~/.config/i3/scripts/keyhint-2
bindsym F1 exec --no-startup-id ~/.config/i3/scripts/keyhint-2

# keybinds buscables con rofi (SUPER+SHIFT+K)
bindsym $mod+Shift+k exec --no-startup-id ~/.config/i3/scripts/rofi-keybinds.sh

# Backlight control
